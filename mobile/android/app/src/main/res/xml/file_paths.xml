<?xml version="1.0" encoding="utf-8"?>
<!-- Only two private folders are exposed: "share" to the app chosen in the share sheet (read), and "camera" to the
     phone's camera app for the one photo it is asked to take (write) -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="share" path="share/" />
    <cache-path name="camera" path="camera/" />
</paths>
